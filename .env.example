# Local Docker Postgres — replace with your own credentials
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5440/docshare?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5440/docshare?schema=public"

# Auth — set your own values locally (never commit real secrets)
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Server
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:5173"
